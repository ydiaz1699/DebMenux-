#!/usr/bin/env bash
# ==========================================================
# DebMenux — Toolkit interactivo para homelab Debian + Docker
# ==========================================================
# Archivo: menu (lanzador principal)
# Descripción: Punto de entrada de DebMenux. Se puede invocar
#              como menú TUI o con subcomandos directos.
#
# Uso:
#   debmenu                   → Lanzar menú TUI interactivo
#   debmenu install <svc>     → Instalar un servicio
#   debmenu update <svc>      → Actualizar un servicio
#   debmenu list              → Listar servicios disponibles
#   debmenu status            → Mostrar estado de servicios instalados
#
# Licencia: MIT
# ==========================================================

# No usar set -euo pipefail — los source de libs pueden retornar != 0

# ==============================================================================
# RUTAS Y CONFIGURACIÓN
# ==============================================================================

export DEBMENUX_BASE_DIR="/debmenux"
export DEBMENUX_SCRIPTS="${DEBMENUX_BASE_DIR}/scripts"
export DEBMENUX_LIB="${DEBMENUX_BASE_DIR}/lib"
export DEBMENUX_CONFIG="${DEBMENUX_BASE_DIR}/config.json"
export DEBMENUX_VERSION=$(cat "${DEBMENUX_BASE_DIR}/version.txt" 2>/dev/null || echo "dev")

# Cargar configuración
if [[ -f "$DEBMENUX_CONFIG" ]]; then
    export DOCKER_DIR=$(jq -r '.docker_dir // "/docker"' "$DEBMENUX_CONFIG")
    export DEBMENUX_LANG=$(jq -r '.language // "es"' "$DEBMENUX_CONFIG")
else
    export DOCKER_DIR="/docker"
    export DEBMENUX_LANG="es"
fi

# Cargar bibliotecas (con protección contra errores en source)
source "${DEBMENUX_LIB}/utils.sh" 2>/dev/null || { echo "Error: No se pudo cargar utils.sh"; exit 1; }
source "${DEBMENUX_LIB}/docker.sh" 2>/dev/null || { echo "Error: No se pudo cargar docker.sh"; exit 1; }
source "${DEBMENUX_LIB}/integration.sh" 2>/dev/null || true

# ==============================================================================
# SUBCOMANDOS
# ==============================================================================

cmd_install() {
    local service="${1:-}"
    if [[ -z "$service" ]]; then
        msg_error "Uso: debmenu install <nombre_servicio>"
        echo -e "${TAB}Ejecuta '${YWB}debmenu list${CL}' para ver servicios disponibles."
        exit 1
    fi

    local script="${DEBMENUX_SCRIPTS}/services/${service}.sh"
    if [[ ! -f "$script" ]]; then
        msg_error "Servicio '${service}' no encontrado."
        echo -e "${TAB}Ejecuta '${YWB}debmenu list${CL}' para ver servicios disponibles."
        exit 1
    fi

    check_root
    check_docker || exit 1
    check_compose || exit 1

    source "$script"
    install_service
}

cmd_update() {
    local service="${1:-}"
    if [[ -z "$service" ]]; then
        msg_error "Uso: debmenu update <nombre_servicio>"
        exit 1
    fi

    local script="${DEBMENUX_SCRIPTS}/services/${service}.sh"
    if [[ ! -f "$script" ]]; then
        msg_error "Servicio '${service}' no encontrado."
        exit 1
    fi

    check_root
    check_docker || exit 1

    source "$script"
    if declare -f update_service &>/dev/null; then
        update_service
    else
        svc_update "$service"
    fi
}

cmd_list() {
    local catalog="${DEBMENUX_BASE_DIR}/services.json"

    if [[ ! -f "$catalog" ]]; then
        msg_error "Catálogo de servicios no encontrado."
        exit 1
    fi

    echo -e "\n${TAB}${BOLD}📦 Servicios disponibles:${CL}\n"
    echo -e "${TAB}${BOLD}$(printf '%-18s %-12s %s' 'SERVICIO' 'CATEGORÍA' 'DESCRIPCIÓN')${CL}"
    msg_separator

    jq -r '.services[] | "\(.id)|\(.category)|\(.description)"' "$catalog" | \
    while IFS='|' read -r id category description; do
        printf "${TAB}%-18s ${BL}%-12s${CL} %s\n" "$id" "$category" "$description"
    done

    echo -e ""
}

cmd_status() {
    check_docker || exit 1

    echo -e "\n${TAB}${BOLD}📊 Servicios instalados:${CL}\n"
    echo -e "${TAB}${BOLD}$(printf '%-18s %s' 'SERVICIO' 'ESTADO')${CL}"
    msg_separator

    local found=0
    for dir in "${DOCKER_DIR}"/*/; do
        if [[ -f "${dir}compose.yml" ]]; then
            local name
            name=$(basename "$dir")
            local status
            status=$(svc_status "$name")
            printf "${TAB}%-18s %s\n" "$name" "$status"
            found=1
        fi
    done

    if [[ "$found" -eq 0 ]]; then
        echo -e "${TAB}${DIM}No hay servicios instalados en ${DOCKER_DIR}${CL}"
    fi

    echo -e ""
}

cmd_menu() {
    check_root
    exec bash "${DEBMENUX_SCRIPTS}/menus/main_menu.sh"
}

# ==============================================================================
# DESPACHO PRINCIPAL
# ==============================================================================

case "${1:-}" in
    install)  shift; cmd_install "$@" ;;
    update)   shift; cmd_update "$@" ;;
    list)     cmd_list ;;
    status)   cmd_status ;;
    help|-h|--help)
        echo -e "\n${BOLD}🐧 DebMenux v${DEBMENUX_VERSION}${CL} — Toolkit para homelab Debian + Docker\n"
        echo -e "Uso: ${YWB}debmenu${CL} [comando] [opciones]\n"
        echo -e "Comandos:"
        echo -e "  ${GN}(ninguno)${CL}       🖥️  Lanzar menú TUI interactivo"
        echo -e "  ${GN}install${CL} <svc>   📦 Instalar un servicio"
        echo -e "  ${GN}update${CL}  <svc>   🆙 Actualizar un servicio"
        echo -e "  ${GN}list${CL}            📋 Listar servicios disponibles"
        echo -e "  ${GN}status${CL}          📊 Mostrar estado de servicios instalados"
        echo -e "  ${GN}help${CL}            ❓ Mostrar esta ayuda"
        echo -e ""
        ;;
    "")       cmd_menu ;;
    *)
        msg_error "Comando desconocido: ${1}"
        echo -e "${TAB}Ejecuta '${YWB}debmenu help${CL}' para ver el uso."
        exit 1
        ;;
esac
